[node name="CutsceneCastle" type="CanvasLayer"]
script = ExtResource("1")
lines = Array[String](["Akhirnya... ini dia, istana yang selama ini disebut-sebut sebagai tempat jodohku menanti.", "Seseorang berpakaian rapi mendatangi Naya.", "Kaukah itu... Naya? Yang selama ini dikatakan akan menjadi jodohku?", "Benar. Dan kau... Pangeran Haris?", "Ya. Sudah lama aku menunggu hari ini tiba.", "Aku tidak menyangka perjalanan ini akan berakhir seindah ini.", "Oh ya aku dengar hari ini kau berulang tahun...", "Selamat Ulang Tahun Sayangkuu Cintakuuu, Semoga kamu selalu cantik, nda suka marah marah lagi, I love u Sayangggg..", "Ayo ikut aku masuk istana akan ku kenalkan semua isi istana"])
speakers = Array[String](["Naya", "", "Haris", "Naya", "Haris", "Naya", "Haris", "Haris"])
next_scene_path = "res://scenes/CutsceneEnding.tscn"

